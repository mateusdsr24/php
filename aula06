<?php

$num = 5;

if($num == 0){
    echo "numero = 0" . "<br>";
}elseif($num > 0){
    echo "numero positivo > 0" . "<br>";
}elseif($num < 0){
    echo "numero negativo < 0" . "<br>";
}else{
    echo "numero invalido" . "<br>";
}

$idade = 18;

if($idade <= 12){
    echo "criança" . "<br>";
}elseif($idade > 12 && $idade <= 17){
    echo "adolescente" . "<br>";
}elseif($idade > 17 && $idade <= 59){
    echo "adulto" . "<br>";
}elseif($idade > 59){
    echo "idoso" . "<br>";
}else{
    echo "idade invalida" . "<br>";
}

$dia = 4;

switch ($dia){
    case 1:
        echo "domingo" . "<br>";
        break;
    case 2:
        echo "segunda" . "<br>";
        break;
    case 3:
        echo "terça" . "<br>";
        break;
    case 4:
        echo "quarta" . "<br>";
        break;
    case 5:
        echo "quinta" . "<br>";
        break;
    case 6:
        echo "sexta" . "<br>";
        break;
    case 7:
        echo "sábado" . "<br>";
    default:
        echo "dia invalido" . "<br>";
    break;
}

$notaum = 4;
$notadois = 10;

$soma = $notaum + $notadois;
$media = $soma / 2;
echo "media das notas: " . $media . "<br>";

if($media >= 7){
    echo "aprovado";
}elseif($media < 7 && $media >= 5){
    echo "recuperação";
}elseif($media < 5){
    echo "reprovado";
}

?>
